# Example environment for Xiaoyuzhou Podcast ASR to Static Site.
PODCAST_ROOT=$HOME/podcast
SENSEVOICE_SITE_PACKAGES=$HOME/deployments/sensevoice/venv/lib/python3.12/site-packages
SENSEVOICE_MODEL_DIR=$HOME/deployments/sensevoice/models/SenseVoiceSmall
SENSEVOICE_PUNC_MODEL_DIR=$HOME/deployments/sensevoice/models/punc-ct-transformer
SENSEVOICE_VAD_MODEL_DIR=$HOME/deployments/sensevoice-docker/modelscope-cache/hub/models/iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
SENSEVOICE_STATIC_ROOT=$HOME/deployments/sensevoice/static
SENSEVOICE_WEB_PORT=8020
PODCAST_ASR_SITE_BASE=http://127.0.0.1:8020/static/podcast-asr
PODCAST_ASR_API_URL=http://127.0.0.1:18021/v1/audio/transcriptions
PODCAST_REMOTE_ASR_CLIENT=$PODCAST_ROOT/remote_asr_client.py
MEETING_ROOT=$HOME/meetings
MEETING_PIPELINE=$PODCAST_ROOT/meeting_asr_pipeline.py
MEETING_ASR_ENDPOINT=http://127.0.0.1:18021/v1/audio/meeting-transcriptions

# x570 worker Compose settings
ASR_BIND_HOST=127.0.0.1
ASR_PORT=18021
SENSEVOICE_MODEL_DIR_HOST=./models/SenseVoiceSmall
SENSEVOICE_VAD_MODEL_DIR_HOST=./models/speech_fsmn_vad
MODELSCOPE_CACHE_HOST=./cache
